# Salin file ini menjadi .env.local, lalu isi dari Firebase Console.
# Project: garagehub-sixtysix

# Project settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=garagehub-sixtysix.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=garagehub-sixtysix
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Project settings > Service accounts > Generate new private key
# Simpan JSON unduhan di secrets/firebase-admin.json
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-admin.json
